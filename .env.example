VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
# Server-only; never expose this as a VITE_ variable.
GEMINI_API_KEY=
# Optional server model override (server default: gemini-3.1-flash-lite,gemini-3.8-flash)
GEMINI_MODEL=
# Optional fallback model override.
GEMINI_FALLBACK_MODEL=
# Optional GA4 web stream ID. Replace the placeholder and rebuild to enable tracking.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Server-only Measurement Protocol secret. Never prefix this with VITE_.
GA4_API_SECRET=
# Optional server override; must match the approved production stream.
GA4_MEASUREMENT_ID=G-RW0RL1ZPKV
